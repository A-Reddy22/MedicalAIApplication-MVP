# Google OAuth (backend only; never commit real values)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Frontend URL used after OAuth callback
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra frontend origins (e.g. preview + custom domain)
FRONTEND_URLS=

# Session signing key (use a long random string)
SESSION_JWT_SECRET=replace-with-a-long-random-secret
# Cookie behavior (set SESSION_COOKIE_SAMESITE=none for cross-site frontend/backend)
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
# Optional custom db file path (default uses /tmp/medadmit-db.json on serverless)
DB_FILE_PATH=
DEBUG_OAUTH=true

# Optional local fallback auth
DEV_AUTH=true
